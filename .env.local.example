# Supabase — get from project settings → API
# v1.0 uses the LEGACY anon/service_role JWT keys (the "Legacy anon, service_role
# API keys" tab). v1.1: migrate to sb_publishable/sb_secret keys — requires bumping
# @supabase/ssr (0.5.2 predates the new key format) and swapping the values below.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — Supabase service role key (NEVER expose to the client).
# Used by `pnpm seed:test-user` and the MFA E2E cleanup; also needed in v1.1 for
# Lemon Squeezy webhooks. Get it from Project Settings → API (service_role secret).
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (used for OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Dev-only E2E test users (seeded in nzx-dev via `pnpm seed:test-user`).
# Read from env only — never hardcoded. Fill with your own dev values locally; in
# CI set them as repo secrets. The auth E2E specs skip when these are unset.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
TEST_MFA_USER_EMAIL=
TEST_MFA_USER_PASSWORD=

# Observability — Sentry (free Developer tier). All optional: with no DSN the SDK is a
# complete no-op, so local dev / CI stay silent. The DSN is not a secret (it's public by
# design). SENTRY_AUTH_TOKEN is build-only — it gates source-map upload and is set just in
# the prod deploy (CI), never needed locally.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Observability — PostHog (free tier: 1M events/mo, 5k replays, 1-yr retention). Optional:
# with no key the provider renders children unchanged and no network calls fire. The key is
# the project's public write key (not a secret). HOST is the region ingest URL —
# `https://us.i.posthog.com` (default) or `https://eu.i.posthog.com`.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# v1.2 — LLM provider (paid, gated behind Pro). Leave empty for v1.0.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# v1.1 — Lemon Squeezy. Leave empty for v1.0.
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
